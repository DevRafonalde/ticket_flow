# Copie este arquivo para ".env" e ajuste os valores.
# O ".env" nunca deve ser commitado (já está no .gitignore).

# ---------- PostgreSQL ----------
POSTGRES_DB=ticketflow
POSTGRES_USER=ticketflow
POSTGRES_PASSWORD=ticketflow123

# ---------- Autenticação / JWT ----------
# Gere um valor forte e aleatório para produção, ex: openssl rand -base64 48
JWT_SECRET=change-me-in-a-real-env-file
JWT_EXPIRATION_MINUTES=60

# ---------- Reserva ----------
# Janela em minutos que o cliente tem para pagar antes da reserva expirar
BOOKING_RESERVATION_TIMEOUT_MINUTES=10

# ---------- Kafka ----------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
